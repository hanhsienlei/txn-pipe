# Password to log in to the app (you choose this)
APP_PASSWORD=

# A long random secret used to sign the auth cookie — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Service Account key (entire JSON on one line, stringified)
# Create a service account, share the spreadsheet with it, then paste the key JSON here
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# The spreadsheet ID from the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=

# Names of the tabs in your spreadsheet (optional — defaults: Expense / Income)
SHEET_EXPENSE_TAB=
SHEET_INCOME_TAB=
